# EC2 控制台環境變量配置範例
# 複製此文件為 .env 並填入實際值

# 應用密碼 - 用於登入網頁控制台
APP_PASSWORD=change-me-to-a-strong-password

# Session 簽名密鑰 - 使用強隨機字符串（建議至少 32 字符）
# 可以用以下命令生成: openssl rand -base64 32
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-characters

# AWS 憑證 - 需要有 DescribeInstances, StartInstances, StopInstances 權限
AWS_ACCESS_KEY_ID=AKIAEXAMPLEACCESSKEY
AWS_SECRET_ACCESS_KEY=example-secret-access-key-replace-with-real-key
